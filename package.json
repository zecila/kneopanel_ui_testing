{
  "name": "kneo_panel_e2e",
  "version": "1.0.0",
  "description": "Read-only-first Playwright tests for the KneoPanel test environment",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ci:doctor": "node scripts/ci-doctor.mjs",
    "test": "playwright test --project=public-read-only --project=read-only",
    "test:ci:smoke": "playwright test --project=public-read-only --project=read-only --grep @smoke --workers=1",
    "test:ci:regression": "playwright test --project=public-read-only --project=read-only --grep-invert @smoke --workers=1",
    "test:ci:cross-browser": "playwright test --project=read-only-firefox --project=read-only-webkit --workers=1",
    "test:auth": "playwright test --project=setup",
    "test:headed": "playwright test --project=read-only --headed",
    "test:ui": "playwright test --project=setup && playwright test --project=public-read-only --project=read-only --no-deps --ui",
    "test:firefox": "playwright test --project=read-only-firefox --workers=1",
    "test:webkit": "playwright test --project=read-only-webkit --workers=1",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:mutating": "node scripts/run-mutating-tests.mjs",
    "test:mutating:ui": "node scripts/run-mutating-tests.mjs --ui",
    "test:ai-mutating": "node scripts/run-ai-mutating-tests.mjs",
    "test:ai-mutating:ui": "node scripts/run-ai-mutating-tests.mjs --ui",
    "test:model-config": "node scripts/run-model-config-tests.mjs",
    "test:model-config:fast": "node scripts/run-model-config-tests.mjs --skip-binary-upload",
    "test:model-config:upload": "node scripts/run-model-config-tests.mjs --stage=upload",
    "test:model-config:generate": "node scripts/run-model-config-tests.mjs --stage=generate",
    "test:model-config:add-version": "node scripts/run-model-config-tests.mjs --stage=add-version",
    "test:model-config:ui": "node scripts/run-model-config-tests.mjs --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}

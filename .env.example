# Required for every local and CI browser run.
# Configure real values only in the ignored .env file or protected CI variables.
KNEO_BASE_URL=
KNEO_SECURITY_ENTRANCE=
KNEO_ADMIN_USERNAME=
KNEO_ADMIN_PASSWORD=

# General mutation lane. Leave disabled for ordinary read-only development.
# Never enable this for the read-only suite.
ALLOW_MUTATIONS=false
# Keep the approved target in a protected local or CI setting.
KNEO_APPROVED_MUTATION_TARGET=

# AI mutation lane. Real model operations have a separate gate. Provider
# discovery is automatic; set the Provider only to override it.
ALLOW_AI_MUTATIONS=false
KNEO_AI_PROVIDER=
# Optional: enables the destructive failed-load recovery case. Set both values.
KNEO_AI_FAILURE_MODEL=
KNEO_AI_FAILURE_VERSION=
# Optional tuning values; defaults are shown.
KNEO_AI_MIN_VRAM_DELTA_MIB=1
KNEO_AI_VRAM_RELEASE_TOLERANCE_MIB=128
KNEO_AI_OPERATION_TIMEOUT_MS=900000
KNEO_AI_ACKNOWLEDGE_WARNINGS=false

# Model registry workflow. Existing models are reused as read-only sources. On
# an empty target, the Qwen weights path and locally discovered archive are the
# fallback; set ARCHIVE only to override repository/parent auto-discovery.
KNEO_MODEL_CONFIG_WEIGHTS_PATH=qwen2_5_0_5b_instruct
KNEO_MODEL_CONFIG_ARCHIVE=
# Disable even the empty-target fallback upload for quick validation reruns.
KNEO_MODEL_CONFIG_SKIP_UPLOAD=false
